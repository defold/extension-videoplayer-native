name: "VideoPlayer"

platforms:
  osx:
    context:
        frameworks: ["AVFoundation", "AVKit", "CoreMedia", "AppKit", "QuartzCore"]

  ios:
    context:
        frameworks: ["AVFoundation", "AVKit", "CoreMedia", "UIKit"]

  win32:
    context:
        libs: ["mf", "mfplat", "mfreadwrite", "mfuuid", "shlwapi", "ole32", "oleaut32", "user32", "gdi32"]
